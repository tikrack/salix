// main.salam - an end-to-end tour of the salix library.
//
// The database engine and credentials come from salix.ini; nothing here is
// hard-coded. Run it with:  salam run main.salam

package main

include salix "src/salix.salam"

// ---- models ----------------------------------------------------------

struct User:
    pub id: i64 = 0
    pub name: str = ""
    pub email: str = ""
    pub age: i64 = 0

    pub func Table(): str:
        ret "users"
    end

    pub func ColumnCount(): int:
        ret 4
    end

    pub func Column(i: int): salix.Column:
        if i == 0: ret salix.AutoKeyCol("id", "i64") end
        if i == 1: ret salix.NotNull(salix.NewColumn("name", "text")) end
        if i == 2: ret salix.Unique(salix.NewColumn("email", "text")) end
        ret salix.NewColumn("age", "i64")
    end

    pub func Get(col: str): salix.Value:
        if col == "id": ret salix.Value.Int(this.id) end
        if col == "name": ret salix.Value.Text(this.name) end
        if col == "email": ret salix.Value.Text(this.email) end
        if col == "age": ret salix.Value.Int(this.age) end
        ret salix.Value {}
    end

    pub func Set(col: str, v: salix.Value): bool:
        if col == "id":
            this.id = v.AsInt()
            ret true
        end
        if col == "name":
            this.name = v.AsText()
            ret true
        end
        if col == "email":
            this.email = v.AsText()
            ret true
        end
        if col == "age":
            this.age = v.AsInt()
            ret true
        end
        ret false
    end
end

struct Post:
    pub id: i64 = 0
    pub user_id: i64 = 0
    pub title: str = ""
    pub views: i64 = 0

    pub func Table(): str:
        ret "posts"
    end

    pub func ColumnCount(): int:
        ret 4
    end

    pub func Column(i: int): salix.Column:
        if i == 0: ret salix.AutoKeyCol("id", "i64") end
        if i == 1: ret salix.NotNull(salix.NewColumn("user_id", "i64")) end
        if i == 2: ret salix.NotNull(salix.NewColumn("title", "text")) end
        ret salix.WithDefault(salix.NewColumn("views", "i64"), "0")
    end

    pub func Get(col: str): salix.Value:
        if col == "id": ret salix.Value.Int(this.id) end
        if col == "user_id": ret salix.Value.Int(this.user_id) end
        if col == "title": ret salix.Value.Text(this.title) end
        if col == "views": ret salix.Value.Int(this.views) end
        ret salix.Value {}
    end

    pub func Set(col: str, v: salix.Value): bool:
        if col == "id":
            this.id = v.AsInt()
            ret true
        end
        if col == "user_id":
            this.user_id = v.AsInt()
            ret true
        end
        if col == "title":
            this.title = v.AsText()
            ret true
        end
        if col == "views":
            this.views = v.AsInt()
            ret true
        end
        ret false
    end
end

// ---- program ---------------------------------------------------------

func main:
    cfg := salix.LoadConfig("salix.ini")
    println "engine:", cfg.engine, "path:", cfg.path

    s := salix.Open(cfg)
    defer s.Close()
    if not s.Ok():
        printerrln "cannot open database:", s.Error()
        ret 1
    end
    println "connected:", s.Kind(), "ping:", s.Ping()

    Migrate(s)
    CrudDemo(s)
    QueryDemo(s)
    RelationDemo(s)
    TransactionDemo(s)

    println "done."
    ret 0
end

func Migrate(s: salix.Session):
    mut m := salix.NewMigrator()
    defer m.items.free()
    salix.AddMigration(
        m, 1, "create_users",
        "CREATE TABLE users (id BIGINT PRIMARY KEY, name TEXT NOT NULL, email TEXT UNIQUE, age BIGINT)",
        "DROP TABLE users"
    )
    salix.AddMigration(
        m, 2, "create_posts",
        "CREATE TABLE posts (id BIGINT PRIMARY KEY, user_id BIGINT NOT NULL, title TEXT NOT NULL, views BIGINT)",
        "DROP TABLE posts"
    )
    applied := salix.Migrate(s, m)
    println "migrations applied:", applied, "schema version:", salix.SchemaVersion(s)
end

func CrudDemo(s: salix.Session):
    println "-- crud --"
    users := salix.NewRepo(User {}, s)
    _ := users.DropTableIfExists()
    if not users.CreateTable():
        printerrln "create failed:", s.Error()
        ret
    end

    mut ids := Vector {} as Vector<i64>
    ids.push(users.Save(User { name = "Ali", email = "ali@example.com", age = 30 }))
    ids.push(users.Save(User { name = "Sara", email = "sara@example.com", age = 25 }))
    ids.push(users.Save(User { name = "Reza", email = "reza@example.com", age = 41 }))
    println "inserted ids:", ids.len(), "total:", users.Total("")

    mut u := User {}
    if users.Find(ids.get(0), u):
        println "found:", u.id, u.name, u.age
    end

    _ := users.Update(User { id = ids.get(0), name = "Ali Reza", email = "ali@example.com", age = 31 })
    mut updated := User {}
    if users.Find(ids.get(0), updated):
        println "updated:", updated.name, updated.age
    end

    println "exists(1):", users.Exists(ids.get(0))
    _ := users.Delete(ids.get(2))
    println "after delete total:", users.Total("")
    ids.free()
end

func QueryDemo(s: salix.Session):
    println "-- queries --"
    users := salix.NewRepo(User {}, s)

    ordered := users.List("", salix.Desc(s, "age"), 10)
    each u in ordered:
        println "user:", u.name, u.age
    end
    ordered.free()

    adults := users.List(salix.Ge(s, "age", salix.Value.Int(30)), salix.Asc(s, "name"), 10)
    println "adults:", adults.len()
    adults.free()

    searched := users.List(salix.Like(s, "name", "%a%"), "", 10)
    println "matched 'a':", searched.len()
    searched.free()

    page := users.Page("", salix.Asc(s, "id"), 1, 1)
    if page.len() > 0:
        println "page row:", page.get(0).name
    end
    page.free()

    rows := s.Query("SELECT name, age FROM users ORDER BY age DESC")
    each row in rows:
        println "raw:", row.Text("name"), row.Int("age")
        row.Free()
    end
    rows.free()
end

func RelationDemo(s: salix.Session):
    println "-- relations --"
    posts := salix.NewRepo(Post {}, s)
    _ := posts.DropTableIfExists()
    if not posts.CreateTable():
        printerrln "create posts failed:", s.Error()
        ret
    end

    users := salix.NewRepo(User {}, s)
    all := users.List("", salix.Asc(s, "id"), 1)
    mut author := 0 as i64
    if all.len() > 0:
        author = all.get(0).id
    end
    all.free()

    _ := posts.Save(Post { user_id = author, title = "Hello Salix", views = 12 })
    _ := posts.Save(Post { user_id = author, title = "Salam world", views = 3 })

    mine := posts.List(salix.Eq(s, "user_id", salix.Value.Int(author)), salix.Desc(s, "views"), 10)
    println "posts by user", author, ":", mine.len()
    each p in mine:
        println "post:", p.title, p.views
    end
    mine.free()

    n := posts.Scalar("SELECT SUM(views) FROM posts WHERE user_id = " + s.Literal(salix.Value.Int(author)))
    println "total views:", n
end

func TransactionDemo(s: salix.Session):
    println "-- transactions --"
    users := salix.NewRepo(User {}, s)
    before := users.Total("")

    mut stmts := Vector {} as Vector<str>
    stmts.push(salix.InsertSQL(s, "users", User { name = "Tx1", email = "tx1@example.com", age = 20 }))
    stmts.push(salix.InsertSQL(s, "users", User { name = "Tx2", email = "tx2@example.com", age = 21 }))
    ok := salix.InTx(s, stmts)
    println "committed:", ok, "delta:", users.Total("") - before
    stmts.free()

    mut bad := Vector {} as Vector<str>
    bad.push(salix.InsertSQL(s, "users", User { name = "Tx3", email = "tx3@example.com", age = 22 }))
    bad.push("INSERT INTO users (name) VALUES (NULL)")
    rolled := salix.InTx(s, bad)
    println "rolled back:", not rolled, "total unchanged:", users.Total("") == before + 2
    bad.free()
end
