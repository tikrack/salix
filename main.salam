include orm "src/orm.salam"

struct User:
    pub id: i64 = 0
    pub name: str = ""
    pub email: str = ""
    pub age: int = 0

    pub func TableName(): str:
        ret "users"
    end
    pub func PrimaryKey(): str:
        ret "id"
    end
    pub func AutoPrimaryKey(): bool:
        ret true
    end
    pub func ColumnCount(): int:
        ret 4
    end
    pub func ColumnName(i: int): str:
        if i == 0: ret "id" end
        if i == 1: ret "name" end
        if i == 2: ret "email" end
        ret "age"
    end
    pub func ColumnValue(i: int): orm.Value:
        if i == 0: ret orm.Value.Int(this.id) end
        if i == 1: ret orm.Value.Text(this.name) end
        if i == 2: ret orm.Value.Text(this.email) end
        ret orm.Value.Int(this.age as i64)
    end
    pub func Assign(col: str, v: orm.Value): bool:
        if col == "id":
            this.id = v.AsInt()
        else col == "name":
            this.name = v.AsText()
        else col == "email":
            this.email = v.AsText()
        else col == "age":
            this.age = v.AsInt() as int
        else:
            ret false
        end
        ret true
    end
end

func main:
    cfg := orm.LoadConfig("orm.ini")
    println "engine:", cfg.engine, "path:", cfg.path

    s := orm.OpenConfig(cfg)
    defer s.Close()
    if not s.Ok():
        printerrln "cannot open database:", s.Error()
        ret 1
    end

    mut t := orm.NewTable("users")
    t = orm.AddColumn(t, orm.AutoIncrement(orm.NewColumn("id", "i64")))
    t = orm.AddColumn(t, orm.NotNullCol(orm.NewColumn("name", "text")))
    t = orm.AddColumn(t, orm.UniqueCol(orm.NewColumn("email", "text")))
    t = orm.AddColumn(t, orm.DefaultCol(orm.NewColumn("age", "int"), "0"))
    _ := orm.DropTableIfExists(s, "users")
    if not orm.CreateTable(s, t):
        printerrln "create table failed:", s.Error()
        ret 1
    end
    orm.FreeTable(t)
    println "table exists:", orm.TableExists(s, "users")

    repo := orm.NewRepo(s, User {})
    _ := repo.Save(User { name = "Ali", email = "ali@example.com", age = 30 })
    _ := repo.Save(User { name = "Sara", email = "sara@example.com", age = 25 })

    mut users := repo.List("", orm.Desc("age"), 10)
    each u in users:
        println u.id, u.name, u.email, u.age
    end
    users.free()

    mut one := User {}
    if repo.Fetch(1, one):
        println "fetched:", one.name
    end

    mut conds := Vector {} as Vector<str>
    conds.push(orm.Eq(s, "age", orm.Value.Int(30)))
    println "count age=30:", repo.Total(orm.And(conds))
    conds.free()

    _ := repo.Modify(User { id = 1, name = "Ali Reza", email = "ali@example.com", age = 31 })
    _ := repo.Remove(2)
    println "total:", repo.Total("")

    mut m := orm.Migrations.New()
    m = m.Add(1, "posts", "CREATE TABLE posts (id INTEGER)", "DROP TABLE posts")
    println "migrations:", m.Count(), "applied:", orm.MigrateAll(s, m), "schema:", orm.SchemaVersion(s)
    m.Free()
end